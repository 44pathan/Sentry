# ── AI Provider (pick ONE) ──────────────────────────────────────────────────
# Option A: Groq (recommended — free, fast)
#   Get key at: https://console.groq.com
OPENAI_API_KEY=gsk_YOUR_GROQ_KEY_HERE
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Option C: Google Gemini (fallback)
# GEMINI_API_KEY=AIza_YOUR_GEMINI_KEY_HERE

# ── Elasticsearch ────────────────────────────────────────────────────────────
ES_HOST=https://localhost:9200
ES_VERIFY_CERTS=false
# ES_USERNAME=elastic
# ES_PASSWORD=your_es_password

# ── Flask ────────────────────────────────────────────────────────────────────
# FLASK_SECRET_KEY is auto-generated if not set — only set this to pin it
# FLASK_SECRET_KEY=your-random-secret-here

# ── Backend ──────────────────────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
# Set to 0.0.0.0 to expose on the network (only do this on a trusted network)
